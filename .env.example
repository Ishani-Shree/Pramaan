# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=pramaan
POSTGRES_PASSWORD=pramaan
POSTGRES_DB=pramaan
POSTGRES_PORT=5434
DATABASE_URL=postgresql://pramaan:pramaan@localhost:5434/pramaan

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local model via Ollama (https://ollama.com). Used alone if GEMINI_API_KEY is empty,
# or as the fallback when Gemini fails. Blank OLLAMA_URL disables it.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Context window per request. Ollama defaults to 2048 and silently truncates longer prompts.
OLLAMA_NUM_CTX=16384

# --- Chunking / retrieval defaults ---
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
# Below this cosine similarity, abstain without calling the LLM (tuned in Step 6).
MIN_SIMILARITY=0.30

# --- Keep big caches off a full C: drive (optional) ---
# HF_HOME=D:/cache/huggingface
