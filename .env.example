# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=pramaan
POSTGRES_PASSWORD=pramaan
POSTGRES_DB=pramaan
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pramaan:pramaan@localhost:5432/pramaan

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional local fallback (https://ollama.com). Leave blank to disable.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# --- Chunking / retrieval defaults ---
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
# Below this cosine similarity, abstain without calling the LLM (tuned in Step 6).
MIN_SIMILARITY=0.30

# --- Keep big caches off a full C: drive (optional) ---
# HF_HOME=D:/cache/huggingface
